{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/orion/frozen-learning-evaluation-v1/dataset.schema.json",
  "title": "ORION independently authored frozen-learning evaluation package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_version",
    "dataset_id",
    "protocol",
    "authorship",
    "timeline",
    "learner_inputs",
    "outcome_releases",
    "evaluator_only_commitment"
  ],
  "properties": {
    "package_version": {
      "const": "orion-independent-restaurant-dataset-v1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^dataset-[a-f0-9]{32,64}$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {
          "const": "orion-frozen-learning-evaluation-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepared_by",
        "preparer_role",
        "prepared_at",
        "fixed_at",
        "independence_basis",
        "engine_source_seen_before_fixing",
        "engine_source_seen_details",
        "engine_results_seen_before_fixing",
        "engine_results_seen_details",
        "preparer_is_engine_implementer",
        "shared_fixture_engine_authorship",
        "answers_fixed_before_execution",
        "learner_visible_material",
        "evaluator_retained_material",
        "review"
      ],
      "properties": {
        "prepared_by": {"$ref": "#/$defs/text"},
        "preparer_role": {"$ref": "#/$defs/text"},
        "prepared_at": {"$ref": "#/$defs/timestamp"},
        "fixed_at": {"$ref": "#/$defs/timestamp"},
        "independence_basis": {"$ref": "#/$defs/text"},
        "engine_source_seen_before_fixing": {"type": "boolean"},
        "engine_source_seen_details": {"$ref": "#/$defs/text"},
        "engine_results_seen_before_fixing": {"type": "boolean"},
        "engine_results_seen_details": {"$ref": "#/$defs/text"},
        "preparer_is_engine_implementer": {"const": false},
        "shared_fixture_engine_authorship": {"const": false},
        "answers_fixed_before_execution": {"const": true},
        "learner_visible_material": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "evaluator_retained_material": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewed_by", "reviewer_role", "reviewed_at", "evidence_sha256"],
          "properties": {
            "status": {"const": "VERIFIED"},
            "reviewed_by": {"$ref": "#/$defs/text"},
            "reviewer_role": {"$ref": "#/$defs/text"},
            "reviewed_at": {"$ref": "#/$defs/timestamp"},
            "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_evidence_cutoff", "evaluation_clock_start"],
      "properties": {
        "discovery_evidence_cutoff": {"$ref": "#/$defs/timestamp"},
        "evaluation_clock_start": {"$ref": "#/$defs/timestamp"}
      }
    },
    "learner_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "company_id", "development", "evaluation"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/opaqueIdentity"},
        "company_id": {"$ref": "#/$defs/opaqueIdentity"},
        "development": {"$ref": "#/$defs/environment"},
        "evaluation": {"$ref": "#/$defs/environment"}
      }
    },
    "outcome_releases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "evaluation"],
      "properties": {
        "development": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/release"}, {"properties": {"case_id": {"const": "development-1"}}}]},
            {"allOf": [{"$ref": "#/$defs/release"}, {"properties": {"case_id": {"const": "development-2"}}}]}
          ],
          "items": false
        },
        "evaluation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/release"}, {"properties": {"case_id": {"const": "evaluation-1"}}}]},
            {"allOf": [{"$ref": "#/$defs/release"}, {"properties": {"case_id": {"const": "evaluation-2"}}}]}
          ],
          "items": false
        }
      }
    },
    "evaluator_only_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sealed_expected_results_sha256", "held_by", "economic_value_criterion"],
      "properties": {
        "sealed_expected_results_sha256": {"$ref": "#/$defs/sha256"},
        "held_by": {"$ref": "#/$defs/text"},
        "economic_value_criterion": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "threshold", "unit", "evidence_required"],
              "properties": {
                "metric": {"$ref": "#/$defs/text"},
                "threshold": {"type": "number"},
                "unit": {"$ref": "#/$defs/text"},
                "evidence_required": {"$ref": "#/$defs/text"}
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "opaqueIdentity": {
      "type": "string",
      "pattern": "^[a-z]_[a-f0-9]{16,64}$"
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "record": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 40,
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueIdentity"},
        "kind": {
          "enum": ["Int", "Float", "Currency", "Percent", "Date", "Link"]
        }
      }
    },
    "recordBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "authorization_id",
        "provenance_source",
        "identity_field",
        "company_field",
        "date_field",
        "records"
      ],
      "properties": {
        "resource_id": {"$ref": "#/$defs/opaqueIdentity"},
        "authorization_id": {"$ref": "#/$defs/opaqueIdentity"},
        "provenance_source": {"$ref": "#/$defs/opaqueIdentity"},
        "identity_field": {"$ref": "#/$defs/opaqueIdentity"},
        "company_field": {"$ref": "#/$defs/opaqueIdentity"},
        "date_field": {"$ref": "#/$defs/opaqueIdentity"},
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {"$ref": "#/$defs/record"}
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fields", "historical_batch"],
      "properties": {
        "id": {"$ref": "#/$defs/opaqueIdentity"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/field"}
        },
        "historical_batch": {"$ref": "#/$defs/recordBatch"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "roots", "parents"],
      "properties": {
        "record_id": {"$ref": "#/$defs/text"},
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "prefixItems": [{"$ref": "#/$defs/text"}, {"$ref": "#/$defs/text"}],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "parents": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "format": "uuid"}
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "resource_id",
        "provenance_source",
        "classes",
        "authorization_id",
        "records",
        "origins"
      ],
      "properties": {
        "source_id": {"type": "string", "format": "uri", "pattern": "^https://s-[a-f0-9]{16,64}\\.synthetic\\.test/?$"},
        "resource_id": {"$ref": "#/$defs/opaqueIdentity"},
        "provenance_source": {"$ref": "#/$defs/opaqueIdentity"},
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["process", "aggregate", "temporal", "relationship", "organizational"]
          }
        },
        "authorization_id": {"$ref": "#/$defs/opaqueIdentity"},
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {"$ref": "#/$defs/record"}
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {"$ref": "#/$defs/origin"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "metadata_authorization_id", "resources", "instruments"],
      "properties": {
        "source_id": {"type": "string", "format": "uri", "pattern": "^https://s-[a-f0-9]{16,64}\\.synthetic\\.test/?$"},
        "metadata_authorization_id": {"$ref": "#/$defs/opaqueIdentity"},
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/resource"}
        },
        "instruments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/instrument"}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "available_at", "source_id", "batches"],
      "properties": {
        "case_id": {
          "enum": ["development-1", "development-2", "evaluation-1", "evaluation-2"]
        },
        "available_at": {"$ref": "#/$defs/timestamp"},
        "source_id": {"type": "string", "format": "uri", "pattern": "^https://s-[a-f0-9]{16,64}\\.synthetic\\.test/?$"},
        "batches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/recordBatch"}
        }
      }
    }
  }
}
