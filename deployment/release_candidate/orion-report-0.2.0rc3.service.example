[Unit]
Description=ORION 0.2.0rc3 synthetic report host
After=network.target

[Service]
Type=simple
User=orion-report
Group=orion-report
EnvironmentFile=/etc/orion/report-0.2.0rc3/report-host.env
ExecStart=/opt/orion/report-0.2.0rc3/bin/python -m orion_http.report_server --binding ${ORION_REPORT_BINDING_PATH} --access-policy ${ORION_REPORT_ACCESS_POLICY_PATH} --service-token-file ${ORION_REPORT_SERVICE_TOKEN_FILE} --port ${ORION_REPORT_PORT}
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/orion-report

[Install]
WantedBy=multi-user.target
